---
// src/components/ReservationForm.astro
import type { Reservation } from "../lib/types";
import { blankReservation } from "../lib/utils";
import FlightLegFields from "./FlightLegFields.astro";

interface Props {
  reservation?: Reservation; // si viene, es edición; si no, es "nueva"
}
const { reservation } = Astro.props;
const isEditing = Boolean(reservation?.id);
const d = reservation ?? { id: "", ...blankReservation() };
---

<form
  id="reservationForm"
  {...isEditing ? { "data-editing-id": d.id } : {}}
  class="flex flex-col gap-6"
  novalidate
>
  <div class="flex items-center justify-between">
    <h2 class="font-display text-2xl font-bold text-navy">
      {isEditing ? "Editar reserva" : "Nueva reserva"}
    </h2>
    <a href="/" class="btn-ghost">← Volver al listado</a>
  </div>

  <div
    class="flex items-center justify-between gap-4 bg-blue-pale border border-line rounded-card p-4"
  >
    <div>
      <h4 class="font-semibold text-navy text-sm">
        Extracción inteligente por IA
      </h4>
      <p class="text-xs text-muted">
        Sube la imagen o documento PDF del boleto para extraer los datos.
      </p>
    </div>
    <div>
      <input
        type="file"
        id="aiFileInput"
        accept="image/*,application/pdf,.pdf"
        class="hidden"
      />
      <button type="button" id="aiUploadBtn" class="btn-gold cursor-pointer"
        >Subir imagen / PDF</button
      >
    </div>
  </div>

  <fieldset
    class="bg-white border border-line rounded-card p-5 flex flex-col gap-4"
  >
    <legend class="font-display font-bold text-navy px-1"
      >Datos del cliente</legend
    >
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <label class="field"
        ><span>Nombre del cliente</span><input
          id="f_clientName"
          type="text"
          value={d.clientName}
        /></label
      >
      <label class="field"
        ><span>N.º de pasaporte</span><input
          id="f_passportNumber"
          type="text"
          value={d.passportNumber}
        /></label
      >
      <label class="field"
        ><span>Código de reserva (agencia)</span><input
          id="f_reservationCode"
          type="text"
          value={d.reservationCode}
        /></label
      >
      <label class="field"
        ><span>PNR aerolínea</span><input
          id="f_pnr"
          type="text"
          value={d.pnr}
        /></label
      >
      <label class="field"
        ><span>N.º de ticket</span><input
          id="f_ticketNumber"
          type="text"
          value={d.ticketNumber}
        /></label
      >
      <label class="field"
        ><span>Fecha de creación</span><input
          id="f_createdDate"
          type="date"
          value={d.createdDate}
        /></label
      >
      <label class="field"
        ><span>Monto pagado</span><input
          id="f_paymentAmount"
          type="text"
          placeholder="628.00 USD"
          value={d.paymentAmount}
        /></label
      >
      <label class="field"
        ><span>Método de pago</span><input
          id="f_paymentMethod"
          type="text"
          placeholder="Efectivo / Transferencia"
          value={d.paymentMethod}
        /></label
      >
    </div>
  </fieldset>

  <fieldset class="bg-white border border-line rounded-card p-5">
    <legend class="font-display font-bold text-navy px-1">
      Vuelos de ida <span
        class="text-[10px] font-semibold uppercase text-bad bg-bad-bg px-1.5 py-0.5 rounded"
        >obligatorio</span
      >
    </legend>
    <div id="outboundLegs">
      {
        d.outboundFlights.map((leg, i) => (
          <FlightLegFields leg={leg} index={i} group="outbound" />
        ))
      }
    </div>
    <button
      type="button"
      data-act="addLeg"
      data-group="outbound"
      class="add-leg cursor-pointer">+ Agregar tramo de ida</button
    >
  </fieldset>

  <fieldset class="bg-white border border-line rounded-card p-5">
    <label class="flex items-center gap-2 text-sm font-semibold text-navy">
      <input
        type="checkbox"
        id="f_hasReturn"
        checked={d.hasReturn}
        class="w-4 h-4 accent-iata cursor-pointer"
      />
      Esta reserva incluye vuelo de regreso
    </label>
    <div id="returnLegsWrap" class={d.hasReturn ? "mt-4" : "hidden mt-4"}>
      <div id="returnLegs">
        {
          d.returnFlights.map((leg, i) => (
            <FlightLegFields leg={leg} index={i} group="return" />
          ))
        }
      </div>
      <button
        type="button"
        data-act="addLeg"
        data-group="return"
        class="add-leg cursor-pointer">+ Agregar tramo de regreso</button
      >
    </div>
  </fieldset>

  <!-- Observaciones de la reserva -->
  <div class="bg-white border border-line rounded-card p-5">
    <label for="f_notes" class="block font-display font-bold text-navy mb-3">
      Observaciones de la reserva
    </label>
    <div
      id="f_notes"
      contenteditable="true"
      class="min-h-35 text-xs text-ink bg-white border border-line rounded-card-sm p-3 focus:outline-none focus:border-iata leading-relaxed overflow-y-auto"
      set:html={d.notes}
    />
  </div>

  <div class="flex justify-end gap-3">
    <a href="/" class="btn-ghost cursor-pointer">Cancelar</a>
    <button type="submit" class="btn-primary cursor-pointer"
      >Guardar reserva</button
    >
  </div>
</form>

<style>
  @reference "../styles/global.css";

  .field {
    @apply flex flex-col gap-1 text-xs font-medium text-muted;
  }
  .field input {
    @apply text-sm text-ink border border-line rounded-card-sm px-2.5 py-1.5 focus:border-iata mt-0.5;
  }
  .add-leg {
    @apply text-xs font-semibold text-iata hover:underline mt-1;
  }
  .btn-ghost {
    @apply text-xs font-semibold px-3 py-1.5 rounded-card-sm border border-line text-navy hover:bg-blue-pale transition;
  }
  .btn-gold {
    @apply text-xs font-semibold px-3 py-1.5 rounded-card-sm bg-moran text-white hover:bg-navy transition;
  }
  .btn-primary {
    @apply text-sm font-semibold px-4 py-2 rounded-card-sm bg-iata text-white hover:bg-navy transition;
  }
</style>

<script>
  import type { FlightLeg, FlightLegTextKey } from "../lib/types";

  console.log("[ReservationForm] Script inicializado en cliente");

  // ---- Helpers de tramos ----
  const LEG_FIELDS: Array<[FlightLegTextKey, string, string?]> = [
    ["airline", "Aerolínea"],
    ["flightNumber", "N.º de vuelo"],
    ["date", "Fecha", "09 nov. 2026"],
    ["depAirport", "Aeropuerto salida", "SAL"],
    ["depCity", "Ciudad salida"],
    ["depTime", "Hora salida", "17:35"],
    ["arrAirport", "Aeropuerto llegada", "ONT"],
    ["arrCity", "Ciudad llegada"],
    ["arrTime", "Hora llegada", "21:00"],
    ["duration", "Duración", "05h 20m"],
  ];

  function blankLeg(): FlightLeg {
    return {
      airline: "",
      flightNumber: "",
      date: "",
      depAirport: "",
      depCity: "",
      depTime: "",
      arrAirport: "",
      arrCity: "",
      arrTime: "",
      duration: "",
      personalItem: true,
      carryOn: false,
      checkedBaggage: true,
      checkedWeight: "23",
      checkedPieces: "1",
    };
  }

  function legBlockHTML(idx: number, group: "outbound" | "return"): string {
    const fields = LEG_FIELDS.map(
      ([key, label, placeholder]) => `
    <label class="field">
      <span>${label}</span>
      <input type="text" data-f="${key}" placeholder="${placeholder ?? ""}" />
    </label>`,
    ).join("");

    return `
    <div class="leg-block border border-line rounded-card-sm p-4 mb-3" data-group="${group}" data-idx="${idx}">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted">Tramo ${idx + 1}</span>
        <button type="button" data-act="removeLeg" data-group="${group}" data-idx="${idx}"
          class="text-xs font-semibold text-bad hover:underline">Quitar</button>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">${fields}</div>

      <div class="baggage-block border-t border-line pt-3 mt-3">
        <span class="text-xs font-semibold uppercase tracking-wide text-muted block mb-2">Equipaje</span>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <label class="flex items-center gap-1.5 text-xs text-muted cursor-not-allowed">
            <input type="checkbox" checked disabled class="w-3.5 h-3.5 accent-iata" />
            Artículo personal <span class="text-[10px]">(incluido siempre)</span>
          </label>
          <label class="flex items-center gap-1.5 text-xs font-medium text-ink cursor-pointer">
            <input type="checkbox" data-f="carryOn" class="w-3.5 h-3.5 accent-iata cursor-pointer" />
            Equipaje de mano <span class="text-muted font-normal">(10 kg)</span>
          </label>
          <label class="flex items-center gap-1.5 text-xs font-medium text-ink cursor-pointer">
            <input type="checkbox" data-f="checkedBaggage" data-toggle="checkedOpts" checked class="w-3.5 h-3.5 accent-iata cursor-pointer" />
            Equipaje documentado
          </label>
          <div class="checked-opts flex items-center gap-3">
            <label class="flex items-center gap-1 text-xs text-muted">
              Piezas
              <input type="number" data-f="checkedPieces" value="1" class="w-14 text-sm text-ink border border-line rounded-card-sm px-1.5 py-1 focus:border-iata" />
            </label>
            <label class="flex items-center gap-1 text-xs text-muted">
              Peso
              <select data-f="checkedWeight" class="text-sm text-ink border border-line rounded-card-sm px-1.5 py-1 focus:border-iata">
                <option value="23">23 kg</option>
                <option value="25">25 kg</option>
              </select>
            </label>
          </div>
        </div>
      </div>
    </div>`;
  }

  function reindexLegs(container: HTMLElement, group: string) {
    container
      .querySelectorAll<HTMLElement>(".leg-block")
      .forEach((block, i) => {
        block.dataset.idx = String(i);
        const label = block.querySelector("span");
        if (label) label.textContent = `Tramo ${i + 1}`;
        block
          .querySelectorAll<HTMLElement>('[data-act="removeLeg"]')
          .forEach((btn) => {
            btn.dataset.idx = String(i);
          });
      });
  }

  const form = document.getElementById("reservationForm") as HTMLFormElement;
  const outboundLegs = document.getElementById("outboundLegs") as HTMLElement;
  const returnLegs = document.getElementById("returnLegs") as HTMLElement;
  const returnWrap = document.getElementById("returnLegsWrap") as HTMLElement;
  const hasReturnCheckbox = document.getElementById(
    "f_hasReturn",
  ) as HTMLInputElement;

  hasReturnCheckbox.addEventListener("change", () => {
    console.log("[Form] Vuelo de regreso tildado:", hasReturnCheckbox.checked);
    returnWrap.classList.toggle("hidden", !hasReturnCheckbox.checked);
    if (hasReturnCheckbox.checked && returnLegs.children.length === 0) {
      console.log("[Form] Agregando tramo de regreso por defecto");
      returnLegs.insertAdjacentHTML("beforeend", legBlockHTML(0, "return"));
    }
  });

  // Toggle de opciones de equipaje documentado con deshabilitación de inputs
  form.addEventListener("change", (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset?.toggle === "checkedOpts") {
      const opts = el
        .closest(".baggage-block")
        ?.querySelector<HTMLElement>(".checked-opts");
      if (opts) {
        opts.style.display = el.checked ? "" : "none";
        opts
          .querySelectorAll<HTMLInputElement | HTMLSelectElement>(
            "input, select",
          )
          .forEach((input) => {
            input.disabled = !el.checked;
          });
      }
    }
  });

  form.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-act]");
    if (!btn) return;
    const act = btn.dataset.act;
    const group = btn.dataset.group as "outbound" | "return" | undefined;

    if (act === "addLeg" && group) {
      const container = group === "outbound" ? outboundLegs : returnLegs;
      console.log(`[Form] Agregando tramo a grupo: ${group}`);
      container.insertAdjacentHTML(
        "beforeend",
        legBlockHTML(container.children.length, group),
      );
    }

    if (act === "removeLeg" && group) {
      const container = group === "outbound" ? outboundLegs : returnLegs;
      if (group === "outbound" && container.children.length === 1) {
        console.warn(
          "[Form] Intento de eliminar el único tramo de ida bloqueado",
        );
        window.showToast("Debe quedar al menos un tramo de ida");
        return;
      }
      console.log(`[Form] Removiendo tramo de grupo: ${group}`);
      const block = btn.closest(".leg-block");
      block?.remove();
      reindexLegs(container, group);
    }
  });

  // ---- Extracción por IA ----
  const aiFileInput = document.getElementById(
    "aiFileInput",
  ) as HTMLInputElement;
  const aiUploadBtn = document.getElementById(
    "aiUploadBtn",
  ) as HTMLButtonElement;
  aiUploadBtn.addEventListener("click", () => aiFileInput.click());

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve((reader.result as string).split(",")[1]);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  function fillForm(data: Record<string, any>) {
    console.log("[Form] Poblando campos con datos de IA:", data);
    const set = (id: string, val: unknown) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el && val !== undefined && val !== null && val !== "")
        el.value = String(val);
    };
    set("f_clientName", data.clientName);
    set("f_passportNumber", data.passportNumber);
    set("f_reservationCode", data.reservationCode);
    set("f_pnr", data.pnr);
    set("f_ticketNumber", data.ticketNumber);
    set("f_paymentAmount", data.paymentAmount);
    set("f_paymentMethod", data.paymentMethod);

    if (data.notes) {
      const notesEl = document.getElementById("f_notes");
      if (notesEl) notesEl.innerHTML = data.notes;
    }

    const fillLegBlock = (
      block: HTMLElement,
      leg: FlightLeg & Record<string, any>,
    ) => {
      LEG_FIELDS.forEach(([key]) => {
        const input = block.querySelector<HTMLInputElement>(
          `[data-f="${key}"]`,
        );
        if (input && leg[key]) input.value = leg[key] as string;
      });

      const carryOnEl =
        block.querySelector<HTMLInputElement>('[data-f="carryOn"]');
      if (carryOnEl) carryOnEl.checked = Boolean(leg.carryOn);

      const checkedEl = block.querySelector<HTMLInputElement>(
        '[data-f="checkedBaggage"]',
      );
      if (checkedEl) checkedEl.checked = leg.checkedBaggage !== false;

      const weightEl = block.querySelector<HTMLSelectElement>(
        '[data-f="checkedWeight"]',
      );
      if (weightEl && leg.checkedWeight)
        weightEl.value = String(leg.checkedWeight);

      const piecesEl = block.querySelector<HTMLInputElement>(
        '[data-f="checkedPieces"]',
      );
      if (piecesEl && leg.checkedPieces)
        piecesEl.value = String(leg.checkedPieces);

      const opts = block.querySelector<HTMLElement>(".checked-opts");
      if (opts) {
        opts.style.display = checkedEl?.checked === false ? "none" : "";
        opts
          .querySelectorAll<HTMLInputElement | HTMLSelectElement>(
            "input, select",
          )
          .forEach((input) => {
            input.disabled = checkedEl?.checked === false;
          });
      }
    };

    if (Array.isArray(data.outboundFlights) && data.outboundFlights.length) {
      outboundLegs.innerHTML = "";
      data.outboundFlights.forEach((leg: FlightLeg, i: number) => {
        outboundLegs.insertAdjacentHTML(
          "beforeend",
          legBlockHTML(i, "outbound"),
        );
        const block = outboundLegs.children[i] as HTMLElement;
        fillLegBlock(block, leg);
      });
    }

    if (
      data.hasReturn &&
      Array.isArray(data.returnFlights) &&
      data.returnFlights.length
    ) {
      hasReturnCheckbox.checked = true;
      returnWrap.classList.remove("hidden");
      returnLegs.innerHTML = "";
      data.returnFlights.forEach((leg: FlightLeg, i: number) => {
        returnLegs.insertAdjacentHTML("beforeend", legBlockHTML(i, "return"));
        const block = returnLegs.children[i] as HTMLElement;
        fillLegBlock(block, leg);
      });
    }
  }

  aiFileInput.addEventListener("change", async () => {
    const file = aiFileInput.files?.[0];
    if (!file) return;

    console.log(
      `[Form IA] Archivo seleccionado: ${file.name} (${file.size} bytes, type: ${file.type})`,
    );
    window.setLoading(true, "Analizando documento con IA…");

    try {
      const base64Data = await fileToBase64(file);
      let mimeType = file.type;
      if (!mimeType) {
        mimeType = file.name.toLowerCase().endsWith(".pdf")
          ? "application/pdf"
          : file.name.toLowerCase().endsWith(".png")
            ? "image/png"
            : "image/jpeg";
      }

      console.log(
        `[Form IA] Enviando payload a /api/extract-ticket (MIME: ${mimeType})`,
      );
      const res = await fetch("/api/extract-ticket", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ base64Data, mimeType }),
      });
      const data = await res.json().catch(() => null);

      if (!res.ok || !data)
        throw new Error(data?.error || `Error al procesar el archivo (HTTP ${res.status})`);

      console.log("[Form IA] Respuesta exitosa recibida");
      fillForm(data);
      window.showToast("¡Documento procesado con éxito!");
    } catch (err) {
      console.error("[Form IA] Error extrayendo ticket:", err);
      window.showToast(
        err instanceof Error ? err.message : "Error al procesar el archivo",
      );
    } finally {
      window.setLoading(false);
      aiFileInput.value = "";
    }
  });

  // ---- Guardar (crear o actualizar) ----
  function collectLegs(container: HTMLElement): FlightLeg[] {
    return Array.from(
      container.querySelectorAll<HTMLElement>(".leg-block"),
    ).map((block) => {
      const leg = blankLeg();
      LEG_FIELDS.forEach(([key]) => {
        const input = block.querySelector<HTMLInputElement>(
          `[data-f="${key}"]`,
        );
        (leg as any)[key] = input?.value ?? "";
      });
      leg.carryOn =
        block.querySelector<HTMLInputElement>('[data-f="carryOn"]')?.checked ??
        false;
      leg.checkedBaggage =
        block.querySelector<HTMLInputElement>('[data-f="checkedBaggage"]')
          ?.checked ?? false;
      leg.checkedWeight =
        (block.querySelector<HTMLSelectElement>('[data-f="checkedWeight"]')
          ?.value as "23" | "25") ?? "23";
      leg.checkedPieces =
        block.querySelector<HTMLInputElement>('[data-f="checkedPieces"]')
          ?.value ?? "1";
      leg.personalItem = true;
      return leg;
    });
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    console.log("[Form Submit] Procesando envío de formulario");

    const val = (id: string) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      return el ? el.value : "";
    };

    const clientName = val("f_clientName").trim();
    if (!clientName) {
      console.warn("[Form Submit] Validación fallida: clientName vacío");
      window.showToast("Ingresa el nombre del cliente");
      return;
    }

    const outbound = collectLegs(outboundLegs);
    const returnF = hasReturnCheckbox.checked ? collectLegs(returnLegs) : [];
    const notesEl = document.getElementById("f_notes");
    const notesValue = notesEl ? notesEl.innerHTML : "";

    const payload = {
      clientName,
      passportNumber: val("f_passportNumber"),
      reservationCode: val("f_reservationCode"),
      pnr: val("f_pnr"),
      ticketNumber: val("f_ticketNumber"),
      createdDate: val("f_createdDate"),
      paymentAmount: val("f_paymentAmount"),
      paymentMethod: val("f_paymentMethod"),
      notes: notesValue,
      hasReturn: hasReturnCheckbox.checked,
      outboundFlights: outbound,
      returnFlights: returnF,
    };

    const editingId = form.dataset.editingId?.trim();
    const isEditing = Boolean(editingId && editingId !== "undefined");

    const url = isEditing
      ? `/api/reservations/${editingId}`
      : "/api/reservations";
    const method = isEditing ? "PUT" : "POST";

    console.log(`[Form Submit] Método: ${method} | URL: ${url}`, payload);

    try {
      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => null);

      if (!res.ok || !data) {
        throw new Error(
          data?.error || `No se pudo guardar la reserva (HTTP ${res.status})`,
        );
      }

      console.log(`[Form Submit] Guardado exitoso (ID: ${data.id})`);
      window.location.href = "/";
    } catch (err) {
      console.error("[Form Submit] Error al guardar reserva:", err);
      window.showToast(
        err instanceof Error ? err.message : "No se pudo guardar la reserva",
      );
    }
  });
</script>
