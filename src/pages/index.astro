---
// src/pages/index.astro
export const prerender = false; // necesita leer Supabase en cada visita

import Layout from "../layouts/Layout.astro";
import ReservationCard from "../components/ReservationCard.astro";
import { supabaseServer } from "../lib/supabase";
import { rowToReservation, type ReservationRow } from "../lib/types";

const { data, error } = await supabaseServer
	.from("reservations")
	.select("*")
	.order("created_date", { ascending: false });

if (error) console.error("index.astro supabase error:", error);
const reservations = ((data as ReservationRow[]) ?? []).map(rowToReservation);
---

<Layout title="Gestor de reservas">
	<div
		slot="topbar"
		class="flex flex-wrap items-center justify-between gap-4 mb-7"
	>
		<div class="flex items-center gap-3">
			<div
				class="w-10 h-10 rounded-full bg-gradient-to-br from-iata to-moran flex items-center justify-center
                  text-white font-display font-extrabold text-lg shadow-card"
			>
				M
			</div>
			<div>
				<h1
					class="font-display font-extrabold text-xl text-navy leading-none"
				>
					MORAN SOLUTIONS
				</h1>
				<span class="text-[11px] tracking-wide text-muted"
					>GESTOR DE RESERVAS</span
				>
			</div>
		</div>
		<div class="flex items-center gap-3">
			<div class="relative">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted"
				>
					<circle cx="11" cy="11" r="7"></circle><path
						d="M21 21l-4.3-4.3"></path>
				</svg>
				<input
					id="searchInput"
					type="text"
					placeholder="Buscar cliente, código o PNR…"
					class="pl-9 pr-3 py-2 text-sm border border-line rounded-card-sm w-64 focus:border-iata"
				/>
			</div>
			<a
				href="/reservas/nueva"
				class="text-sm font-semibold px-4 py-2 rounded-card-sm bg-iata text-white hover:bg-navy transition"
			>
				+ Nueva reserva
			</a>
			<form method="POST" action="/api/auth/logout">
				<button
					type="submit"
					class="text-sm font-semibold px-3 py-2 rounded-card-sm border border-line text-navy hover:bg-blue-pale transition cursor-pointer"
				>
					Salir
				</button>
			</form>
		</div>
	</div>

	<div class="mb-4">
		<span
			id="countPill"
			class="text-xs font-semibold text-muted bg-white border border-line rounded-full px-3 py-1"
		>
			{reservations.length} reserva{reservations.length === 1 ? "" : "s"}
		</span>
	</div>

	{
		reservations.length ? (
			<div
				id="grid"
				class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"
			>
				{reservations.map((r) => (
					<div
						class="reservation-item"
						data-search={`${r.clientName} ${r.reservationCode} ${r.pnr}`.toLowerCase()}
					>
						<ReservationCard reservation={r} />
					</div>
				))}
			</div>
		) : (
			<div class="text-center py-16 bg-white border border-dashed border-line rounded-card">
				<h3 class="font-display font-bold text-navy mb-1">
					Aún no hay reservas
				</h3>
				<p class="text-sm text-muted mb-4">
					Agrega tu primera reserva completando los campos manualmente
					o mediante IA.
				</p>
				<a
					href="/reservas/nueva"
					class="text-sm font-semibold px-4 py-2 rounded-card-sm bg-iata text-white hover:bg-navy transition"
				>
					+ Nueva reserva
				</a>
			</div>
		)
	}
</Layout>

<script>
	const searchInput = document.getElementById(
		"searchInput",
	) as HTMLInputElement | null;
	const items = Array.from(
		document.querySelectorAll<HTMLElement>(".reservation-item"),
	);

	searchInput?.addEventListener("input", () => {
		const q = searchInput.value.trim().toLowerCase();
		let visible = 0;
		items.forEach((item) => {
			const match = !q || (item.dataset.search ?? "").includes(q);
			item.classList.toggle("hidden", !match);
			if (match) visible++;
		});
		const pill = document.getElementById("countPill");
		if (pill)
			pill.textContent = `${visible} reserva${visible === 1 ? "" : "s"}`;
	});

	document.addEventListener("click", async (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLElement>(
			'[data-act="delete"]',
		);
		if (!btn) return;
		const id = btn.dataset.id;
		if (!id || !confirm("¿Eliminar esta reserva?")) return;

		const res = await fetch(`/api/reservations/${id}`, {
			method: "DELETE",
		});
		if (res.ok) {
			btn.closest(".reservation-item")?.remove();
			window.showToast("Reserva eliminada");
		} else {
			window.showToast("No se pudo eliminar la reserva");
		}
	});
</script>
