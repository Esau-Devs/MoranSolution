---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light" />
		<meta name="darkreader-lock" />
		<link rel="icon" type="image/jpeg" href="/logo-moran.jpeg" />
		<title>{title} · Moran Solutions</title>
	</head>
	<body>
		<div id="app" class="max-w-[1180px] mx-auto px-6 pt-7 pb-20">
			<slot name="topbar" />
			<slot />
		</div>

		<div id="printArea" class="hidden print:block"></div>

		<div
			id="toast"
			class="fixed bottom-6 left-1/2 -translate-x-1/2 translate-y-4 opacity-0 pointer-events-none
           transition-all duration-200 bg-navy text-white text-sm font-medium
           px-4 py-2.5 rounded-card-sm shadow-card z-50"
		>
		</div>

		<div
			id="loading"
			class="hidden fixed inset-0 z-40 flex-col items-center justify-center gap-2 bg-navy/90 text-white"
		>
			<div
				class="h-9 w-9 rounded-full border-4 border-white/30 border-t-white animate-spin"
			>
			</div>
			<div id="loadingText" class="text-sm font-semibold">
				Procesando documento con IA…
			</div>
			<div class="text-xs opacity-80">
				Extrayendo todos los campos dinámicamente…
			</div>
		</div>

		<script>
			// Singleton de toast/loading disponible para cualquier <script> de página.
			declare global {
				interface Window {
					showToast: (msg: string) => void;
					setLoading: (show: boolean, text?: string) => void;
				}
			}

			let toastTimer: ReturnType<typeof setTimeout>;
			window.showToast = (msg: string) => {
				const el = document.getElementById("toast");
				if (!el) return;
				el.textContent = msg;
				el.classList.remove("opacity-0", "translate-y-4");
				el.classList.add("opacity-100", "translate-y-0");
				clearTimeout(toastTimer);
				toastTimer = setTimeout(() => {
					el.classList.add("opacity-0", "translate-y-4");
					el.classList.remove("opacity-100", "translate-y-0");
				}, 2600);
			};

			window.setLoading = (
				show: boolean,
				text = "Procesando documento…",
			) => {
				const el = document.getElementById("loading");
				const txt = document.getElementById("loadingText");
				if (txt) txt.textContent = text;
				if (el) {
					el.classList.toggle("hidden", !show);
					el.classList.toggle("flex", show);
				}
			};
		</script>
	</body>
</html>
